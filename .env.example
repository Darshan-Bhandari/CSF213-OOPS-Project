# Reference only. Copy to .env; scripts/run-local.sh loads it without executing shell code.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campus_itsm
SPRING_DATASOURCE_USERNAME=campus_itsm
SPRING_DATASOURCE_PASSWORD=
# Demo seeding is opt-in; leave blank until you choose a local demo password.
DEMO_PASSWORD=
# Both are optional. Set them later to enable live AI features.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# disabled | local (private local demo files, Mac/Linux only) | smtp
RECOVERY_MODE=disabled
APP_BASE_URL=http://127.0.0.1:8080
RECOVERY_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
